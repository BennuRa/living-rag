# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

# PostgreSQL + pgvector
POSTGRES_DB=living_rag
POSTGRES_USER=living_rag
POSTGRES_PASSWORD=change-me-before-production
DATABASE_URL=postgresql+psycopg://living_rag:change-me-before-production@postgres:5432/living_rag

# Model providers (enabled from Day 5/6)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text

# Agent safety limits (enabled with the LangGraph workflow)
MAX_RETRIEVAL_CANDIDATES=8
MAX_GROUNDED_CHUNKS=4
MAX_QUERY_REWRITES=1
MAX_GENERATION_REPAIRS=1
MAX_TOOL_CALLS_PER_RUN=3
